apiVersion: kubectl.config.k8s.io/v1beta1
kind: Preference
defaults:
  - command: apply
    options:
      - name: server-side
        default: "true"
  - command: delete
    options:
      - name: interactive
        default: "true"
aliases:
  - name: tail
    command: logs
    appendArgs:
      - --timestamps=1
      - --follow
      - --tail=100
