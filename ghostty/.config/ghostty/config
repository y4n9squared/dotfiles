clipboard-paste-protection = true
confirm-close-surface = false
cursor-style = block
cursor-style-blink = false
font-family = FiraCode Nerd Font Mono
font-size = 13
font-style = Light
font-family-bold = FiraCode Nerd Font Mono
font-style-bold = Regular
font-thicken = true
quit-after-last-window-closed = true
theme = Catppuccin Mocha
window-padding-x = 10
window-padding-y = 10

# Mirror tmux mappings
keybind = cmd+s>n=new_window
keybind = cmd+s>v=new_split:right
keybind = cmd+s>h=new_split:down
keybind = cmd+s>z=toggle_split_zoom
keybind = cmd+s>equal=equalize_splits

# LADR pane navigation
keybind = cmd+h=goto_split:left
keybind = cmd+l=goto_split:right
keybind = cmd+j=goto_split:bottom
keybind = cmd+k=goto_split:top
